{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product event",
  "type": "object",
  "required": ["schema_version", "event_id", "company_ids", "headline", "section_id", "event_kind", "launch_stage", "markets", "article_ids", "facts", "eligibility", "ranking", "context_assessment"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "event_id": {"type": "string", "minLength": 1},
    "company_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "headline": {"type": "string", "minLength": 1, "description": "Русский заголовок карточки события, сформированный при смысловой обработке Article. Event JSON сохраняется в UTF-8."},
    "section_id": {"enum": ["features", "monetization", "trust_safety", "ai", "new_models", "business", "marketing"]},
    "event_kind": {"enum": ["product_change", "product_policy", "threat_signal", "business_event", "marketing_event"]},
    "launch_stage": {"enum": ["announced", "pilot", "beta", "launched", "expanded", "rumor", "unknown", "not_applicable"]},
    "markets": {"type": "array", "items": {"type": "string"}},
    "article_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "previous_event_id": {"type": ["string", "null"]},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "article_id", "evidence_quote"],
        "properties": {
          "claim": {"type": "string", "description": "Факт по-русски с сохранением условий, чисел, стадии и оговорок исходной публикации."},
          "article_id": {"type": "string"},
          "evidence_quote": {"type": "string", "minLength": 1, "description": "Точная цитата на языке оригинала из Article, указанного в article_id; не заменять русским переводом."}
        }
      }
    },
    "eligibility": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": {"enum": ["pending", "included", "excluded", "needs_review"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ranking": {
      "type": ["object", "null"],
      "required": ["criteria", "total_score"],
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "score", "rationale"],
            "properties": {
              "name": {"enum": ["business_relevance", "information_novelty", "actionability", "evidence_quality", "market_impact"]},
              "score": {"type": "number", "minimum": 0, "maximum": 5},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        },
        "total_score": {"type": "number", "minimum": 0, "maximum": 100},
        "context_version": {"type": "string"},
        "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "context_assessment": {
      "type": ["object", "null"],
      "required": ["relevance_type", "question_ids", "claim_ids", "rationale", "application_horizon"],
      "properties": {
        "relevance_type": {"enum": ["decision_support", "market_watch"]},
        "question_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rationale": {"type": "string", "minLength": 1},
        "application_horizon": {"enum": ["pilot_design", "future_option", "market_watch"]}
      },
      "allOf": [{
        "if": {"type": "object", "properties": {"relevance_type": {"const": "decision_support"}}, "required": ["relevance_type"]},
        "then": {"properties": {"question_ids": {"minItems": 1}}}
      }]
    }
  },
  "$comment": "Контекст Lovito используется только для so what после отбора. При отборе context_assessment = null; оценки и допуск от него не зависят. Поля context_assessment и контекстные метаданные ranking сохранены для чтения прежних артефактов. В новом выпуске context_refs формируются непосредственно из context_bundle.json; decision_support требует непустого question_ids, market_watch допускает пустые ID при конкретном обосновании значимости."
}
