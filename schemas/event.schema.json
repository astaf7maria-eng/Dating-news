{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product event",
  "type": "object",
  "required": ["schema_version", "event_id", "company_ids", "headline", "section_id", "event_kind", "launch_stage", "markets", "article_ids", "facts", "eligibility", "ranking"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "event_id": {"type": "string", "minLength": 1},
    "company_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "headline": {"type": "string", "minLength": 1},
    "section_id": {"enum": ["features", "monetization", "trust_safety", "ai", "new_models", "business", "marketing"]},
    "event_kind": {"enum": ["product_change", "product_policy", "threat_signal", "business_event", "marketing_event"]},
    "launch_stage": {"enum": ["announced", "pilot", "beta", "launched", "expanded", "rumor", "unknown", "not_applicable"]},
    "markets": {"type": "array", "items": {"type": "string"}},
    "article_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "previous_event_id": {"type": ["string", "null"]},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "article_id", "evidence_quote"],
        "properties": {
          "claim": {"type": "string"},
          "article_id": {"type": "string"},
          "evidence_quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "eligibility": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": {"enum": ["pending", "included", "excluded", "needs_review"]},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ranking": {
      "type": ["object", "null"],
      "required": ["criteria", "total_score", "context_version"],
      "properties": {
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "score", "rationale"],
            "properties": {
              "name": {"enum": ["business_relevance", "information_novelty", "actionability", "evidence_quality", "market_impact"]},
              "score": {"type": "number", "minimum": 0, "maximum": 5},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        },
        "total_score": {"type": "number", "minimum": 0, "maximum": 100},
        "context_version": {"type": "string"}
      }
    }
  }
}
