  "retrieval_policy": {
    "window": "Из подтверждённого manifest; параметры дат добавляет адаптер поискового провайдера, не жёсткая строка запроса",
    "mandatory_coverage": "Нельзя урезать обязательные компании при лимите бюджета молча; статус coverage_incomplete и список пропущенных запросов",
    "source_lookup": "Сначала нейтральные свежие разделы официальных источников и ключевых СМИ, один раз на URL. site-запрос — уточнение незавершённого источника/направления.",
    "soft_negative_signals": [
      "гороскоп",
      "dating tips",
      "celebrity gossip"
    ],
    "negative_filter_mode": "Исключать тип материала по смыслу, без глобальных -best/-review/-survey. Заголовок помогает раннему отсеву; сомнение требует текста.",
    "collection_before_ranking": true,
    "candidate_filter": {
      "excluded_types": [
        "service_comparison",
        "best_services_list",
        "choice_guide",
        "usage_guide",
        "evergreen_overview",
        "old_event_reprint"
      ],
      "title_rules": [
        {
          "reason": "best_services_list",
          "pattern": "^\\s*(?:the\\s+)?(?:\\d+\\s+)?(?:best|top)\\s+(?:\\d+\\s+)?dating\\s+(?:apps?|sites?|services?)\\b"
        },
        {
          "reason": "best_services_list",
          "pattern": "^\\s*(?:(?:топ)[\\s\\-–—:]*(?:\\d+)?\\s*|(?:\\d+\\s+)?лучши[ехй]\\s+)(?:приложени[яй]|сайты|сайтов|сервисы|сервисов)\\s+(?:для\\s+)?знакомств"
        },
        {
          "reason": "service_comparison",
          "pattern": "^\\s*[\\w .&/+\\-]{1,60}\\s+(?:vs\\.?|versus|против)\\s+"
        },
        {
          "reason": "service_comparison",
          "pattern": "^\\s*(?:чем\\s+отлича(?:ются|ется)|(?:в\\s+ч[её]м\\s+)?(?:разница|отличи[ея])\\s+между|сравнение\\s+(?:сервисов|приложений))\\b"
        },
        {
          "reason": "choice_guide",
          "pattern": "^\\s*(?:како[йе]\\s+(?:сервис|приложение|сайт)\\s+(?:знакомств\\s+)?(?:лучше|выбрать)|(?:which|what)\\s+dating\\s+(?:app|site|service)\\s+(?:is\\s+(?:the\\s+)?best|should\\s+(?:i|you)\\s+choose))\\b"
        },
        {
          "reason": "usage_guide",
          "pattern": "^\\s*(?:how\\s+to\\s+use\\s+(?:tinder|bumble|hinge|mamba|vk\\s+dating)|как\\s+пользоваться\\s+(?:тиндером|бамбл|мамбой|vk|вк))\\b"
        }
      ],
      "campaign_title_guard": {
        "actions": [
          "launch",
          "introduc",
          "unveil",
          "запуст",
          "представ"
        ],
        "objects": [
          "campaign",
          "кампани",
          "activation",
          "активаци"
        ]
      },
      "uncertain": "needs_review",
      "comparison_with_feature": "Само сравнение исключить; новую фичу проверить по отдельному сообщению о запуске.",
      "date_rule": "Проверить published_at и новый факт в окне. dateModified, дата URL и свежая индексация не доказывают новизну."
    },
    "term_selection": "build_followup_query выбирает намерение и синоним по сигналу/пробелу; отрицательные изменения, интервью и результаты доступны на RU/EN/ZH/JA. Первый элемент списка не задаёт все последующие обращения."
  },
  "notes": "Fast v1.1: новостные разделы → открытые события и внешние интервью/результаты → уточнения по сигналам. Новые компании сохраняются кандидатами. Отсутствие классов новостей за период допустимо. План не выполняет сеть автоматически.",
